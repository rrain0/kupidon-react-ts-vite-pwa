{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Editor Support */
    "disableSizeLimit": true, // allow ts to allocate any amount of memory
    
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    //"noUnusedLocals": true,
    //"noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false, // allow access obj.prop in indexed type instead of obj['prop']
    "noUncheckedIndexedAccess": false, // add undefined when get props from indexed type
    "exactOptionalPropertyTypes": true, // '?' means absence of property but not undefined
    "downlevelIteration": true, // use [...anyIterator]
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "allowUnreachableCode": true, // allow code after the return statement that never runs
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true, // enables some modern patterns for class properties initialization
    
    // Path aliases
    // They are duplicated in vite.config.ts to support service-worker aliases
    "baseUrl": ".",
    "paths": {
      "*": [
        "src/*",
        "node_modules_overrides/*"
      ],
      
      "src/*": ["src/*"],
      
      "@util/*": ["src/util/*"],
      "@mini-libs/*": ["src/mini-libs/*"],
      
      "@res/*": ["src/res/*"],
      "@im/*": ["src/res/im/*"],
      "@ic/*": ["src/res/ic/*"],
      "@vid/*": ["src/res/vid/*"],
      
      "@animated/*": ["src/mini-libs/animated/*"]
    }
  },
  "include": ["src", "node_modules_overrides"],
}
