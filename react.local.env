
# Сначала идём в react nginx proxy
PROXY_HOST=kupidon.local.rraindev
PROXY_PORT=40001
PROXY_CERT_CRT=./nginx-proxy/certs-local/????
PROXY_CERT_KEY=./nginx-proxy/certs-local/????

# Потом react nginx proxy идёт в react
REACT_PORT=40009

# Дальше react идёт в ktor nginx proxy
KTOR_HOST=kupidon.local.rraindev
KTOR_PORT=40011
# No slash at the end
BACKEND_BASE_URL=https://${KTOR_HOST}:${KTOR_PORT}
