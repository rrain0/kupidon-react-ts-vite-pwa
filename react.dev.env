
# Сначала идём в react nginx proxy
# Вручную надо установить в локальном nginx
PROXY_HOST=kupidon.dev.rraindev
# Вручную надо установить в локальном nginx
PROXY_PORT=40002
# Вручную надо установить в локальном nginx
CERT_FILE=./nginx/cert-dev/kupidon.dev.rraindev.pem.crt
# Вручную надо установить в локальном nginx
CERT_KEY=./nginx/cert-dev/kupidon.dev.rraindev.pem.key

# Потом react nginx proxy идёт в react
# Вручную надо установить в локальном nginx
# Автоподтягивается в vite.config
REACT_PORT=40009

# Дальше react идёт в ktor nginx proxy
KTOR_HOST=kupidon.dev.rraindev
KTOR_PORT=40012
# Api base url without slash at the end
API_BASE_URL=https://${KTOR_HOST}:${KTOR_PORT}/api
