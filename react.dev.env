
# Сначала идём в react nginx proxy
# Вручную надо установить в локальном nginx
PROXY_HOST=kupidon.dev.rraindev
# Вручную надо установить в локальном nginx
PROXY_PORT=40002
# Вручную надо установить в локальном nginx
PROXY_CERT_CRT=./nginx-proxy/certs-dev/kupidon.dev.rraindev.pem.crt
# Вручную надо установить в локальном nginx
PROXY_CERT_KEY=./nginx-proxy/certs-dev/kupidon.dev.rraindev.pem.key

# Потом react nginx proxy идёт в react
# Вручную надо установить в локальном nginx
# Автоподтягивается в vite.config
REACT_PORT=40009

# Дальше react идёт в ktor nginx proxy
BACKEND_HOST=kupidon.dev.rraindev
BACKEND_PORT=40012
